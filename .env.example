# Postgres connection string (docker-compose default shown)
DATABASE_URL="postgresql://mailpilot:mailpilot@localhost:5432/mailpilot"

# AES-256 key used to encrypt stored SMTP passwords at rest (any long random string)
ENCRYPTION_KEY="replace-with-a-random-secret"

# Public URL this app is reachable at — used to build click-tracking redirect links.
# Leave unset to send campaigns with untracked links.
APP_BASE_URL="http://localhost:3000"
