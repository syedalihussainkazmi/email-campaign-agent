# Postgres connection string (docker-compose default shown)
DATABASE_URL="postgresql://mailpilot:mailpilot@localhost:5432/mailpilot"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console -> OAuth Client, enable Gmail API + gmail.send scope)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AES-256 key used to encrypt stored OAuth tokens at rest (any long random string)
ENCRYPTION_KEY="replace-with-a-random-secret"

# "mock" (default, safe for local dev with no Gmail credentials) or "gmail" (sends real email)
EMAIL_SENDER="mock"
